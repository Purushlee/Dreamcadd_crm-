# Copy this file to .env and fill in real values (do not commit .env)

DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to "postgres" to use PostgreSQL instead of the default SQLite.
DB_ENGINE=sqlite
DB_NAME=dreamcadd
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# WhatsApp Cloud API (Meta) — from developers.facebook.com / business.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dreamcadd-verify-token
